{
  "name": "mathos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/browser-repro.mjs && node scripts/browser-life.mjs && node scripts/browser-ecology.mjs && node scripts/browser-learning.mjs && node scripts/browser-terminal.mjs && node scripts/browser-mobile.mjs && node scripts/browser-genome.mjs && node scripts/browser-testfield.mjs && node scripts/browser-layout.mjs",
    "benchmark": "node --expose-gc scripts/substrate-benchmark.mjs",
    "setup:local": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:core": "node scripts/verify.mjs --core",
    "handoff:check": "node scripts/check-handoff.mjs",
    "opencode:check": "node scripts/check-opencode.mjs",
    "experiment:baseline": "node scripts/ecology-baseline.mjs",
    "agent": "node scripts/start-opencode.mjs",
    "experiment:learning": "node scripts/learning-comparison.mjs",
    "experiment:evaluate": "node scripts/evaluate-ecology.mjs",
    "test:replay": "node scripts/replay-test-report.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.17.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "playwright": "^1.56.1"
  }
}
