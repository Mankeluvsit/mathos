{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MATHOS ecology v4 starting definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "seed",
    "mode",
    "learning",
    "structuralMutation"
  ],
  "properties": {
    "format": {
      "const": "mathos-ecology"
    },
    "version": {
      "type": "integer",
      "const": 4
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mode": {
      "enum": [
        "seeded",
        "primordial"
      ]
    },
    "learning": {
      "type": "boolean"
    },
    "structuralMutation": {
      "type": "boolean"
    }
  },
  "$id": "https://mathos.local/schemas/ecology-v4.schema.json"
}
