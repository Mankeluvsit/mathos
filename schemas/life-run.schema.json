{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MATHOS life definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "name",
    "seed",
    "universe",
    "engine",
    "rng",
    "genesis",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "mathos-life-run"
    },
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        }
      }
    },
    "engine": {
      "const": "life-reference@1"
    },
    "rng": {
      "const": "mulberry32@1"
    },
    "genesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "recipe",
        "template"
      ],
      "properties": {
        "mode": {
          "enum": [
            "primordial",
            "seeded"
          ]
        },
        "recipe": {
          "const": "resource-noise@1"
        },
        "template": {
          "const": "center-cell@1"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "boundary",
        "transferDivisor"
      ],
      "properties": {
        "id": {
          "const": "pixel-life@1"
        },
        "boundary": {
          "enum": [
            "periodic",
            "closed"
          ]
        },
        "transferDivisor": {
          "type": "integer",
          "enum": [
            8,
            16
          ]
        }
      }
    }
  }
}
