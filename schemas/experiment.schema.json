{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Mankeluvsit/mathos/schemas/experiment.schema.json",
  "title": "MATHOS experiment configuration v1",
  "description": "Configuration intent only; not a simulation checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "name", "seed", "universe", "genesis"],
  "properties": {
    "format": { "const": "mathos-experiment" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 8, "maximum": 256 },
        "height": { "type": "integer", "minimum": 8, "maximum": 256 }
      }
    },
    "genesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["primordial", "seeded"] } }
    }
  }
}
