{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MATHOS substrate run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "name",
    "seed",
    "universe",
    "engine",
    "rng",
    "initializer",
    "rules"
  ],
  "properties": {
    "format": {
      "const": "mathos-substrate-run"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "substrate-reference"
          ]
        },
        "version": {
          "const": 1
        }
      }
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "mulberry32"
          ]
        },
        "version": {
          "const": 1
        }
      }
    },
    "initializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "uniform-noise",
            "center-impulse"
          ]
        },
        "version": {
          "const": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "boundary",
        "transferDivisor"
      ],
      "properties": {
        "id": {
          "enum": [
            "conservative-transport"
          ]
        },
        "version": {
          "const": 1
        },
        "boundary": {
          "enum": [
            "periodic",
            "closed"
          ]
        },
        "transferDivisor": {
          "enum": [
            8,
            16
          ]
        }
      }
    }
  }
}
