{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MATHOS ecology starting definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "seed",
    "mode"
  ],
  "properties": {
    "format": {
      "const": "mathos-ecology"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mode": {
      "enum": [
        "seeded",
        "primordial"
      ]
    }
  }
}
